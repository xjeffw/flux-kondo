;; The special forms, and the functions the runtime implements in other namespaces.
(ns flux.builtins-extra)

(in-ns 'flux.core)
(def ^:special-form def nil)
(def ^:special-form defn nil)
(def ^:special-form defn- nil)
(def ^:special-form defonce nil)
(def ^:special-form set-local! nil)
(def ^:special-form defmacro nil)
(def ^:special-form if nil)
(def ^:special-form do nil)
(def ^:special-form let nil)
(def ^:special-form fn nil)
(def ^:special-form try nil)
(def ^:special-form catch nil)
(def ^:special-form finally nil)
(def ^:special-form var nil)
(def ^:special-form declare nil)
(def ^:special-form ns nil)
(def ^:special-form after! nil)
(def ^:special-form on-reload! nil)
(def ^:special-form with-read-lock nil)
(def ^:special-form quote nil)

(in-ns 'flux.string)
(declare trimr)
